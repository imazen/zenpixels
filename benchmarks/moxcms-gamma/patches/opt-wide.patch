+//! Private normal-input power kernel adapted from pxfm 0.1.30, commit
+//! acf7acd00cfc845307eda7b7b2de19e42303de82 (powf/log2f/exp2f).
+//! The logarithm and correction retain its f32 arithmetic. Scaling uses f64
+//! so a normal input can produce a correctly ranged f32 subnormal or infinity.
+#![forbid(unsafe_code)]
+
+#[rustfmt::skip]
+const EXP2_BITS: [u32; 64] = [0x3f3504f3, 0x3f36fd92, 0x3f38fbaf, 0x3f3aff5b, 0x3f3d08a4, 0x3f3f179a, 0x3f412c4d, 0x3f4346cd, 0x3f45672a, 0x3f478d75, 0x3f49b9be, 0x3f4bec15, 0x3f4e248c, 0x3f506334, 0x3f52a81e, 0x3f54f35b, 0x3f5744fd, 0x3f599d16, 0x3f5bfbb8, 0x3f5e60f5, 0x3f60ccdf, 0x3f633f89, 0x3f65b907, 0x3f68396a, 0x3f6ac0c7, 0x3f6d4f30, 0x3f6fe4ba, 0x3f728177, 0x3f75257d, 0x3f77d0df, 0x3f7a83b3, 0x3f7d3e0c, 0x3f800000, 0x3f8164d2, 0x3f82cd87, 0x3f843a29, 0x3f85aac3, 0x3f871f62, 0x3f88980f, 0x3f8a14d5, 0x3f8b95c2, 0x3f8d1adf, 0x3f8ea43a, 0x3f9031dc, 0x3f91c3d3, 0x3f935a2b, 0x3f94f4f0, 0x3f96942d, 0x3f9837f0, 0x3f99e046, 0x3f9b8d3a, 0x3f9d3eda, 0x3f9ef532, 0x3fa0b051, 0x3fa27043, 0x3fa43516, 0x3fa5fed7, 0x3fa7cd94, 0x3fa9a15b, 0x3fab7a3a, 0x3fad583f, 0x3faf3b79, 0x3fb123f6, 0x3fb311c4];
+
+#[inline(always)]
+fn madd(a: f32, b: f32, c: f32) -> f32 {
+    #[cfg(any(
+        all(
+            any(target_arch = "x86", target_arch = "x86_64"),
+            target_feature = "fma"
+        ),
+        target_arch = "aarch64"
+    ))]
+    {
+        a.mul_add(b, c)
+    }
+    #[cfg(not(any(
+        all(
+            any(target_arch = "x86", target_arch = "x86_64"),
+            target_feature = "fma"
+        ),
+        target_arch = "aarch64"
+    )))]
+    {
+        a * b + c
+    }
+}
+
+/// x is positive normal and exponent is in [0.25,4]. Caller proves both.
+#[inline(always)]
+pub(crate) fn normal_power(x: f32, exponent: f32) -> f32 {
+    let adjusted = x.to_bits().wrapping_add(0x3f80_0000 - 0x3f35_04f3);
+    let n = (adjusted >> 23) as i32 - 127;
+    let a = f32::from_bits((adjusted & 0x007f_ffff) + 0x3f35_04f3);
+    let z = (a - 1.0) / (a + 1.0);
+    let z2 = z * z;
+    let u = madd(0.4121985850084821691, z2, 0.5770780163490337802);
+    let u = madd(u, z2, 0.9617966939259845749);
+    let log = madd(z2 * z, u, madd(z, 2.885390081777926802, n as f32));
+    let y = exponent * log;
+    const REDUX: f32 = 196608.0;
+    let bits = (y + REDUX).to_bits();
+    let packed = bits.wrapping_add(32);
+    let index = packed & 63;
+    let k = (packed >> 6) as i32 - (REDUX.to_bits() >> 6) as i32;
+    let fraction = y - (f32::from_bits(bits) - REDUX);
+    let polynomial = madd(0.24022650695908768, fraction, 0.69314718055994973) * fraction;
+    let base = f32::from_bits(EXP2_BITS[index as usize]);
+    let corrected = madd(polynomial, base, base);
+    let scale = f64::from_bits(((k + 1023) as u64) << 52);
+    (f64::from(corrected) * scale) as f32
+}
