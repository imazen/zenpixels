+                0.5,
+                1.,
+                f32::MAX,
+                f32::INFINITY,
+                f32::NAN,
+            ] {
+                let input = Rgb::new(x, 0.5, 0.0);
+                let output = pure_gamma_tristimulus(input, exponent);
+                for (value, actual) in [
+                    (input.r, output.r),
+                    (input.g, output.g),
+                    (input.b, output.b),
+                ] {
+                    let expected = pure_gamma_function_f(value, exponent);
+                    if expected.is_nan() {
+                        assert!(actual.is_nan());
+                    } else {
+                        assert_eq!(actual.to_bits(), expected.to_bits());
+                    }
+                }
+            }
+        }
+    }
